<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>latestmajor</LangVersion>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="DeepCopy" Version="1.0.3" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="6.0.35" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.2" />
    <PackageReference Include="System.Net.Http.Json" Version="6.0.0" />
    <PackageReference Include="iiif-net" Version="0.2.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Abstractions" Version="6.0.0" />
    <PackageReference Include="Microsoft.Extensions.Options.ConfigurationExtensions" Version="6.0.0" />
    <PackageReference Include="NetVips" Version="3.2.0" />
    <!-- libvips binaries for where we run (Linux containers) and develop (Windows); the NetVips.Native meta-package would publish every platform -->
    <PackageReference Include="NetVips.Native.linux-x64" Version="8.18.7" />
    <PackageReference Include="NetVips.Native.win-x64" Version="8.18.7" Condition="$([MSBuild]::IsOSPlatform('Windows'))" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
  </ItemGroup>

  <ItemGroup>
    <!-- Inter, for PDF cover pages; embedded so no file path has to be right at runtime -->
    <EmbeddedResource Include="Resources/fonts/Inter-Regular.ttf" />
    <EmbeddedResource Include="Resources/fonts/Inter-Bold.ttf" />
    <!-- the footer logo: a copy of Wellcome.Dds.Server/wwwroot/logos/wellcome-collection-black.png -->
    <EmbeddedResource Include="Resources/logos/wellcome-collection-black.png" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\DlcsWebClient\DlcsWebClient.csproj" />
    <ProjectReference Include="..\Wellcome.Dds.AssetDomainRepositories\Wellcome.Dds.AssetDomainRepositories.csproj" />
    <ProjectReference Include="..\Wellcome.Dds.Common\Wellcome.Dds.Common.csproj" />
    <ProjectReference Include="..\Wellcome.Dds\Wellcome.Dds.csproj" />
  </ItemGroup>

</Project>
