@model Wellcome.Dds.Dashboard.Models.Settings.BuildModel

@{
    ViewBag.Title = "Build";
    var build = Model.Build;
    // All times in the dashboard's usual format, in local (London) time
    const string dateFormat = "dd/MM/yy HH:mm:ss";
}

<div class="col-md-12">
    <h3 style="margin: 25px 0 20px 0">What is deployed here</h3>
    <p>
        This is the dashboard's own image. A deploy moves all four images (dashboard, iiif-builder, job-processor,
        workflow-processor) to the same tag, so the rest of <strong>@Model.EnvironmentName</strong> is normally running the same build.
    </p>
</div>

<div class="row">
    <div class="col-md-12">
        @if (!build.IsKnown)
        {
            <p class="alert alert-warning">
                This is a local build: only images built by GitHub Actions (.github/workflows/build.yml) record what they were built from.
            </p>
        }
        <table class="table table-condensed">
            @if (build.IsKnown)
            {
                <tr>
                    <th>Commit</th>
                    <td><a href="@build.CommitUrl"><code>@build.Commit</code></a></td>
                </tr>
                <tr>
                    <th>Pull request</th>
                    <td>
                        @if (string.IsNullOrEmpty(build.PullRequest))
                        {
                            <span>none found</span>
                        }
                        else
                        {
                            <a href="@build.PullRequestUrl">#@build.PullRequest</a> @build.PullRequestTitle
                        }
                    </td>
                </tr>
                <tr>
                    <th>Commit message</th>
                    <td>@build.CommitSubject</td>
                </tr>
                <tr>
                    <th>Commit author, date</th>
                    <td>@build.CommitAuthor, @(build.CommitDateLocal?.ToString(dateFormat) ?? build.CommitDate)</td>
                </tr>
                <tr>
                    <th>Built from</th>
                    <td><a href="@build.RefUrl">@build.Ref</a></td>
                </tr>
                <tr>
                    <th>Since release</th>
                    <td><code>@build.Describe</code></td>
                </tr>
                <tr>
                    <th>Built</th>
                    <td><a href="@build.Run">@(build.DateLocal?.ToString(dateFormat) ?? build.Date)</a></td>
                </tr>
            }
            <tr>
                <th>Environment</th>
                <td>@Model.EnvironmentName</td>
            </tr>
            <tr>
                <th>Dashboard running since</th>
                <td>@Model.Started.ToString(dateFormat) <span class="text-muted">(the last deploy or restart of this container)</span></td>
            </tr>
            <tr>
                <th>Runtime</th>
                <td>@Model.Framework</td>
            </tr>
            <tr>
                <th>Host</th>
                <td>@Model.MachineName</td>
            </tr>
        </table>
    </div>
</div>
